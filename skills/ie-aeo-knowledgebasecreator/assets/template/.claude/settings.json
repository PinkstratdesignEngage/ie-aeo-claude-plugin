{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/controlla-allineamento.sh --sempre --evento=SessionStart",
            "timeout": 30,
            "statusMessage": "Controllo allineamento con GitLab"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/controlla-allineamento.sh --evento=UserPromptSubmit",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "ie-aeo": {
      "source": {
        "source": "git",
        "url": "https://gitlab.example.com/aeo/claudeplugin/IE-AEO.git"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "ie-aeo@ie-aeo": true
  }
}
